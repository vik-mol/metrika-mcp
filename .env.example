# OAuth-токен с правами metrika:read и metrika:write
YANDEX_METRIKA_TOKEN=
# ID вашего счётчика Яндекс Метрики (обязательно)
YANDEX_METRIKA_COUNTER_ID=
# Таймаут запросов к API в миллисекундах (необязательно, по умолчанию 15000)
YANDEX_METRIKA_TIMEOUT_MS=15000
# Папка локальных отчётов (относительно корня проекта или абсолютный путь)
YANDEX_METRIKA_EXPORT_DIR=exports
# Максимальный размер ответа в MCP (10 МиБ); большие ответы сохраняйте в файл
YANDEX_METRIKA_MAX_INLINE_BYTES=10485760
# Максимальный размер одной выгрузки (1 ГиБ)
YANDEX_METRIKA_MAX_EXPORT_BYTES=1073741824
# Максимум страниц за одну выгрузку; достижение лимита отмечается complete=false
YANDEX_METRIKA_MAX_EXPORT_PAGES=10000
# Папка локальных CSV/JSON для потокового импорта
YANDEX_METRIKA_IMPORT_DIR=imports
# Максимальный размер файла импорта (1 ГиБ)
YANDEX_METRIKA_MAX_IMPORT_BYTES=1073741824
